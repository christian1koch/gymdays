{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@gymDays/db": ["libs/gymdays/features/db/db.ts"],
			"@gymDays/services": ["libs/gymdays/features/services/services.ts"],
			"@gymDays/actions": [
				"libs/gymdays/features/store/gym-days-slice.ts"
			],
			"@gymDays/components/*": ["libs/gymdays/components/*"],
