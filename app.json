{
	"expo": {
		"name": "gymdays-app",
		"slug": "gymdays-app",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/gym-days-icon.png",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/gym-days-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "c1k.gymdays"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/gym-days-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "c1k.gymdays"
		},
		"web": {
			"favicon": "./assets/gym-days-icon.png"
		},
		"plugins": ["expo-router", "expo-font"],
		"scheme": "your-app-scheme"
	}
}
